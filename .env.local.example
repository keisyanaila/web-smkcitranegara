# Salin file ini jadi .env.local lalu isi nilainya.
#   cp .env.local.example .env.local
# Di Vercel: isi variabel yang sama di Project → Settings → Environment Variables, lalu Redeploy.
# JANGAN commit .env.local (sudah di-ignore git) — berisi password & akses database.

# Connection string database Neon (PostgreSQL).
# Ambil dari Neon dashboard → project → Connect → salin "Connection string".
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Password untuk masuk ke /admin. Pakai password yang kuat.
ADMIN_PASSWORD="ganti-dengan-password-admin"

# Setelah DATABASE_URL terisi, buat/lengkapi tabel sekali:
#   node db/run-schema.mjs
# (atau tempel isi db/schema.sql di Neon → SQL Editor → Run)
